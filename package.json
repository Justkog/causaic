{
  "name": "causaic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "turbo run build",
    "causaic-runner": "pnpm --filter @causaic/runner build && pnpm --filter @causaic/runner cli",
    "convex:smoke": "pnpm --filter @causaic/coordinator-convex smoke",
    "desktop:build": "pnpm --filter @causaic/desktop build",
    "desktop:dev": "pnpm --filter @causaic/desktop dev",
    "desktop:package": "pnpm --filter @causaic/desktop package",
    "plugins:dev:check": "node scripts/sync-causaic-dev-plugins.mjs",
    "plugins:dev:sync": "node scripts/sync-causaic-dev-plugins.mjs --write",
    "plugins:marketplace:check": "node scripts/validate-plugin-marketplaces.mjs",
    "test:convex-demo-live": "pnpm --filter @causaic/runner test:convex-live",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
