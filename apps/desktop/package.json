{
  "name": "@causaic/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Development-only Causaic Node desktop vertical slice",
  "type": "module",
  "main": "app/out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "dev": "node ../../scripts/prepare-desktop-runtime.mjs && electron-vite dev",
    "lint": "eslint src electron.vite.config.ts vitest.config.ts --max-warnings=0",
    "package": "pnpm build && node ../../scripts/package-desktop.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@causaic/coordinator-convex": "workspace:*",
    "@causaic/coordinator-core": "workspace:*",
    "@causaic/protocol": "workspace:*",
    "@causaic/runner-core": "workspace:*",
    "@causaic/runtime-core": "workspace:*",
    "@causaic/runtime-fake": "workspace:*",
    "@causaic/workflow-schema": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@causaic/coordinator-memory": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
